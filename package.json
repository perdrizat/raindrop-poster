{
  "name": "raindrop",
  "version": "1.1.1",
  "main": "index.js",
  "scripts": {
    "dev:client": "pnpm -C client dev",
    "dev:server": "pnpm -C server dev",
    "dev": "concurrently \"pnpm dev:client\" \"pnpm dev:server\"",
    "test": "pnpm -C client test && pnpm -C server test",
    "test:e2e": "pnpm -C server test:e2e",
    "lint": "pnpm -C client lint && pnpm -C server lint",
    "build": "docker build -t raindrop-poster:$(node -p \"require('./package.json').version\") -t raindrop-poster:latest .",
    "release": "pnpm version patch",
    "deploy:remote": "./scripts/deploy-remote.sh"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
